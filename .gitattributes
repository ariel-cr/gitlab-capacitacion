# Este laboratorio se edita en Windows y se ejecuta en macOS y Linux.
#
# Sin esto, Git convierte los finales de línea al clonar en Windows y los
# scripts vuelven a quedar con CRLF. En bash eso produce el error
# «bad interpreter: /usr/bin/env bash^M», que no dice nada útil y cuesta
# una hora encontrar.
#
# La regla: todo texto se guarda y se entrega con LF, sin excepciones.

* text=auto eol=lf

*.sh      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.tsv     text eol=lf
*.md      text eol=lf
Dockerfile text eol=lf

# PowerShell sí quiere CRLF: sólo lo ejecuta Windows.
*.ps1     text eol=crlf

*.png binary
